<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"><data><variable name="vm" type="com.example.app3.AlbumViewModel"/></data>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="310dp" android:paddingTop="16dp" android:paddingBottom="16dp">
<androidx.constraintlayout.widget.Guideline android:id="@+id/labels" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent=".15"/>
<androidx.constraintlayout.widget.Guideline android:id="@+id/fields" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent=".43"/>
<androidx.constraintlayout.widget.Guideline android:id="@+id/right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent=".96"/>
<TextView android:id="@+id/title_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Title" android:labelFor="@id/title" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="@id/labels" app:layout_constraintEnd_toStartOf="@id/fields" app:layout_constraintTop_toTopOf="@id/title" app:layout_constraintBottom_toBottomOf="@id/title"/>
<EditText android:id="@+id/title" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="8dp" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" android:text="@={vm.title}"  app:layout_constraintStart_toStartOf="@id/fields" app:layout_constraintEnd_toStartOf="@id/right" app:layout_constraintTop_toTopOf="parent"/>
<TextView android:id="@+id/artist_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Artist" android:labelFor="@id/artist" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="@id/labels" app:layout_constraintEnd_toStartOf="@id/fields" app:layout_constraintTop_toTopOf="@id/artist" app:layout_constraintBottom_toBottomOf="@id/artist"/>
<EditText android:id="@+id/artist" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="8dp" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" android:text="@={vm.artist}"  app:layout_constraintStart_toStartOf="@id/fields" app:layout_constraintEnd_toStartOf="@id/right" app:layout_constraintTop_toBottomOf="@id/title"/>
<CheckBox android:id="@+id/classical" android:layout_width="0dp" android:layout_height="48dp" android:text="Classical" android:checked="@={vm.classical}" app:layout_constraintStart_toStartOf="@id/labels" app:layout_constraintEnd_toStartOf="@id/right" app:layout_constraintTop_toBottomOf="@id/artist"/>
<TextView android:id="@+id/composer_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Composer" android:labelFor="@id/composer" android:layout_marginEnd="8dp" app:layout_constraintStart_toStartOf="@id/labels" app:layout_constraintEnd_toStartOf="@id/fields" app:layout_constraintTop_toTopOf="@id/composer" app:layout_constraintBottom_toBottomOf="@id/composer"/>
<EditText android:id="@+id/composer" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="8dp" android:inputType="text" android:singleLine="true" android:importantForAutofill="no" android:text="@={vm.composer}" android:enabled="@{vm.classical}" app:layout_constraintStart_toStartOf="@id/fields" app:layout_constraintEnd_toStartOf="@id/right" app:layout_constraintTop_toBottomOf="@id/classical"/>
<LinearLayout android:id="@+id/buttons" android:layout_width="0dp" android:layout_height="52dp" android:orientation="horizontal" android:layout_marginTop="12dp" app:layout_constraintStart_toStartOf="@id/fields" app:layout_constraintEnd_toStartOf="@id/right" app:layout_constraintTop_toBottomOf="@id/composer" app:layout_constraintBottom_toBottomOf="parent">
<Button android:id="@+id/cancel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="Cancel" android:textAllCaps="false" android:onClick="@{() -> vm.cancel()}"/>
<Space android:layout_width="30dp" android:layout_height="1dp"/>
<Button android:id="@+id/apply" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="Apply" android:textAllCaps="false" android:onClick="@{() -> vm.apply()}"/>
</LinearLayout></androidx.constraintlayout.widget.ConstraintLayout></layout>
